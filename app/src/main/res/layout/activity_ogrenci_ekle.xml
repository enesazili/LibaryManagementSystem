<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yeni Öğrenci Kaydı"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/edit_student_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Adı Soyadı" />

    <EditText
        android:id="@+id/edit_student_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Okul Numarası"
        android:inputType="number" />

    <EditText
        android:id="@+id/edit_student_tc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="TC Kimlik No"
        android:inputType="number"
        android:maxLength="11" />

    <Button
        android:id="@+id/btn_save_student"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VERİTABANINA KAYDET"
        android:layout_marginTop="30dp"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"/>
</LinearLayout>